{
  "name": "e-journey",
  "version": "1.0.0",
  "private": true,
  "description": "E-Journey - forum, schedule, e-learning, and achievement platform",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/scripts/migrate.js",
    "migrate:elearning": "node server/migrate-elearning.js",
    "seed": "node server/scripts/seed.js",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.11.5",
    "pdfkit": "^0.20.2"
  }
}
